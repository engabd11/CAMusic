<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi-only downloads read the active network's transport. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Light Sync reacting to *other apps* (Settings > Light Sync > "Other apps").
      RECORD_AUDIO is what AudioPlaybackCapture is gated on even though no microphone
      is ever opened: the platform has one permission for "this app can receive audio
      it did not produce", and this is it. Nothing here records the microphone, and
      the feature is off until it is explicitly set up.

      Note this is visible on the store listing and in the app's own permission page
      whether or not anyone turns the feature on. That is the cost of the feature
      existing at all; see capture/PlaybackCapture.kt.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Local audio files: READ_MEDIA_AUDIO is the modern permission (API 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!--
      For Android 12 and below we also request legacy storage read. minSdk is 31,
      so this is only needed on API 31-32. On API 33+ READ_MEDIA_AUDIO replaces it.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
      Driving mode.

      BLUETOOTH_CONNECT is the *only* automatic trigger, and deliberately so: the
      obvious framing is "show the bar when Google Maps is in front", and reading the
      foreground app needs either PACKAGE_USAGE_STATS or an AccessibilityService —
      a Settings-screen grant or the most policy-sensitive permission on the
      platform. The requirement is "control music without leaving the map", not
      "know that Maps is running", and connecting to the car's stereo is the same
      situation for one runtime permission.

      SYSTEM_ALERT_WINDOW is only needed for the overlay mechanism, which is the
      *upgrade* rather than the default — Picture-in-Picture costs nothing and leads.
      It is a sensitive permission under Play policy; this app ships on a debug
      keystore by design (see the README), so that is not a blocker today, but it
      would become one if release signing ever happens.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      "Pause for calls" (AppSettings.pauseForCalls, off by default). Only needed for
      TelephonyCallback.CallStateListener to notice a ringing/answered call — this
      app reads no phone number, no call log, nothing beyond the state enum, and
      only registers the listener when the setting is turned on.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      Speed limit alert and speed-adaptive volume (AppSettings.speedLimitAlertEnabled /
      speedAdaptiveVolume, both off by default). Coarse would not do: the trigger
      speed is computed to within a few km/h of a posted limit, and coarse location's
      city-block-scale error would make the alert fire on the wrong stretch of road.
      Requested at runtime only when either feature is turned on.

      ACCESS_COARSE_LOCATION is declared alongside the fine permission because
      Android 12+ requires both when FINE is requested — the user may grant only
      coarse, and the speed alert degrades gracefully (it simply triggers a few
      km/h earlier or later, which the tolerance percentage already absorbs).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      ACCESS_FINE_LOCATION is a *while-in-use* grant, and an app that is not on
      screen only keeps it while it runs a foreground service declared with the
      `location` type. Driving mode's whole premise is that the driver is looking at
      Google Maps rather than at this app, so without this the speed-limit alert
      stopped receiving fixes the moment it became useful - silently, with no error
      and no callback. See DrivingLocationService, which is the only thing that
      starts a service of that type, and only while a speed feature is switched on
      and the location grant is actually held.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      Android Auto. Not required for Auto to bind to CarMediaLibraryService (Auto
      queries this app, not the other way round) - only for this app's own code to
      be able to ask PackageManager whether Gearhead is installed, under Android
      11+ package-visibility rules, should that ever be useful.
    -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <!--
      Predictive back: targetSdk 36 expects an app to have opted in, and the M3
      motion work below relies on the back gesture being animated rather than
      cutting straight to the previous screen.
    -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".SendpinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CAMusic"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CAMusic">

        <!--
          singleTask so a notification tap resumes the running task instead of
          building a second instance on top of it. See service/OpenApp.kt.

          supportsPictureInPicture is what makes driving mode's default mechanism
          possible at all. configChanges is not optional alongside it: without
          screenSize|smallestScreenSize|screenLayout the activity is *recreated* on
          the way into and out of PiP, which for this app means tearing down and
          rebuilding the whole Compose tree at the exact moment someone is pulling
          away from a junction.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.CAMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Light Sync in the notification shade. `TOGGLEABLE_TILE` is what lets the
          user add it from Quick Settings' own edit screen without opening the app;
          `BIND_QUICK_SETTINGS_TILE` is the system's guarantee that only SystemUI can
          bind it, which is why the service is exported.
        -->
        <service
            android:name=".service.LightSyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_light_sync_tile"
            android:label="@string/light_sync_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Driving mode's tile — the manual trigger beside the car's Bluetooth. -->
        <service
            android:name=".service.DrivingModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_driving_tile"
            android:label="@string/driving_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
          The driving bar's overlay window (option E1). Not a foreground service:
          it holds no wake lock, decodes nothing and does no work between taps — the
          window is the whole of it, and it only exists while DrivingMode says so.
        -->
        <service
            android:name=".service.DrivingOverlayService"
            android:exported="false" />

        <!--
          Holds the MediaProjection while Light Sync listens to other apps. The
          `mediaProjection` type is not decoration: on API 34+ the platform refuses
          getMediaProjection() unless a service of exactly this type is already in the
          foreground. See PlaybackCaptureService.onStartCommand.
        -->
        <service
            android:name=".capture.PlaybackCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!--
          The consent dialog trampoline. A MediaProjection token can only come from an
          Activity result, and the service that uses it outlives every Activity.
        -->
        <activity
            android:name=".capture.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.SendspinConnectionService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <service
            android:name=".service.SendspinService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <!-- The standalone (Navidrome / offline) player's own media notification.
             Separate from SendspinService, which follows the Music Assistant
             stream: the two track different state and are never both playing. -->
        <service
            android:name=".service.LocalPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <!--
          The permission anchor that keeps GPS alive while the driver is in another
          app. Its own service rather than a second type on a playback one, because
          the platform grants location on the type a service actually started with:
          a media service that added `location` to its manifest would still start as
          mediaPlayback and change nothing. See DrivingLocationService.
        -->
        <service
            android:name=".service.DrivingLocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!--
          Ambience effects. A third service rather than a third role for one of the
          others: the sound here is synthesised, so there is no ExoPlayer and no
          MediaSession to expose, and an ambience show is not a track that "next"
          or a scrub bar could mean anything for. What it does need is to stay
          unfrozen while the phone is put down, which is all this provides.
        -->
        <service
            android:name=".service.EffectsService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <!--
          Android Auto's browse tree and session, distinct from the two services
          above: those come and go with playback, but Auto needs something bound
          and queryable (browse, search) whether or not anything is currently
          playing. Decodes nothing itself - see CarMediaLibraryService's own doc.
          Exported because that is how Auto's MediaBrowserService binder reaches it.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".car.CarMediaLibraryService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- "Hey Google, play X in CAMusic" - routes through the same
                 onSetMediaItems/CarLibraryBridge.play() path as a browse tap. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!--
          The home-screen widget. Glance supplies the receiver; this is only the
          manifest registration and the size metadata it reads.
        -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- Headset / Bluetooth / steering-wheel media buttons now route through
             each service's media3 MediaSession directly (see ShadePlayer /
             LocalPlaybackService) - no MediaButtonReceiver or MEDIA_BUTTON
             intent-filter needed for either. -->
        <!--
          Hands a generated file to the share sheet without loosening anything:
          the grant is per-URI, read-only and lives only as long as the receiving
          activity. Scoped to one cache subdirectory - see res/xml/shared_files.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

    </application>
</manifest>
