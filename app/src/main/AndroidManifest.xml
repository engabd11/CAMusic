<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi-only downloads read the active network's transport. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Local audio files: READ_MEDIA_AUDIO is the modern permission (API 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!--
      For Android 12 and below we also request legacy storage read. minSdk is 31,
      so this is only needed on API 31-32. On API 33+ READ_MEDIA_AUDIO replaces it.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
      Driving mode.

      BLUETOOTH_CONNECT is the *only* automatic trigger, and deliberately so: the
      obvious framing is "show the bar when Google Maps is in front", and reading the
      foreground app needs either PACKAGE_USAGE_STATS or an AccessibilityService —
      a Settings-screen grant or the most policy-sensitive permission on the
      platform. The requirement is "control music without leaving the map", not
      "know that Maps is running", and connecting to the car's stereo is the same
      situation for one runtime permission.

      SYSTEM_ALERT_WINDOW is only needed for the overlay mechanism, which is the
      *upgrade* rather than the default — Picture-in-Picture costs nothing and leads.
      It is a sensitive permission under Play policy; this app ships on a debug
      keystore by design (see the README), so that is not a blocker today, but it
      would become one if release signing ever happens.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Predictive back: targetSdk 36 expects an app to have opted in, and the M3
      motion work below relies on the back gesture being animated rather than
      cutting straight to the previous screen.
    -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".SendpinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CAMusic"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Sendspin">

        <!-- singleTask so a notification tap resumes the running task instead of
             building a second instance on top of it. See service/OpenApp.kt. -->
        <!--
          supportsPictureInPicture is what makes driving mode's default mechanism
          possible at all. configChanges is not optional alongside it: without
          screenSize|smallestScreenSize|screenLayout the activity is *recreated* on
          the way into and out of PiP, which for this app means tearing down and
          rebuilding the whole Compose tree at the exact moment someone is pulling
          away from a junction.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Sendspin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Light Sync in the notification shade. `TOGGLEABLE_TILE` is what lets the
          user add it from Quick Settings' own edit screen without opening the app;
          `BIND_QUICK_SETTINGS_TILE` is the system's guarantee that only SystemUI can
          bind it, which is why the service is exported.
        -->
        <service
            android:name=".service.LightSyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_light_sync_tile"
            android:label="@string/light_sync_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Driving mode's tile — the manual trigger beside the car's Bluetooth. -->
        <service
            android:name=".service.DrivingModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_driving_tile"
            android:label="@string/driving_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
          The driving bar's overlay window (option E1). Not a foreground service:
          it holds no wake lock, decodes nothing and does no work between taps — the
          window is the whole of it, and it only exists while DrivingMode says so.
        -->
        <service
            android:name=".service.DrivingOverlayService"
            android:exported="false" />

        <service
            android:name=".service.SendspinConnectionService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <service
            android:name=".service.SendspinService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <!-- The standalone (Navidrome / offline) player's own media notification.
             Separate from SendspinService, which follows the Music Assistant
             stream: the two track different state and are never both playing. -->
        <service
            android:name=".service.LocalPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
        </service>

        <!-- Headset / Bluetooth / steering-wheel media buttons now route through
             each service's media3 MediaSession directly (see ShadePlayer /
             LocalPlaybackService) - no MediaButtonReceiver or MEDIA_BUTTON
             intent-filter needed for either. -->
    </application>
</manifest>
