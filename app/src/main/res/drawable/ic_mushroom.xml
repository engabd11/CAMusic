<?xml version="1.0" encoding="utf-8"?>
<!--
  The CAMusic mark, for use inside the app — the onboarding header and the boot
  splash, both of which drew a letter "S" left over from when the app was Sendspin.

  Separate from ic_launcher_foreground.xml rather than shared with it. That one is a
  108dp canvas whose outer 18dp a launcher may mask away, so its mark is inset to
  survive the crop; reused at 24dp in a layout it would sit in a pool of empty space.
  Same shape, drawn to fill its box.

  Filled white so `Icon(tint = …)` can recolour it — the onboarding mark is drawn in
  the page's ink on an accent tile, the reverse of the launcher icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Cap: a dome overhanging the stem, flat along its underside. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.6,13.2 C3.6,7.6 7.4,3.8 12,3.8 C16.6,3.8 20.4,7.6 20.4,13.2 Z"/>

    <!-- Stem: tapers in under the cap, then rounds off at the foot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.1,13.2 L13.9,13.2 C13.9,16 13.6,18.5 12.7,20.1 C12.4,20.7 11.6,20.7 11.3,20.1 C10.4,18.5 10.1,16 10.1,13.2 Z"/>
</vector>
