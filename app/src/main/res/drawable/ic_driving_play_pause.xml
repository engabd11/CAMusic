    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/textColorPrimary">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,5v14l7,-7zM14,5h2.5v14L14,19zM18.5,5L21,5v14h-2.5z" />
</vector>
