<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pure-black launch theme. The app is OLED-dark end to end, so the window
      starts at #000 (no white flash before Compose draws) and both system bars
      are transparent for the edge-to-edge album wash.

      Parent changed from android:Theme.Material.NoActionBar (Material 2) to
      Theme.Material3.NoActionBar to align the XML theme layer with the Compose
      MaterialTheme. The visual output is identical — the window is still black
      and the bars are still transparent — but the base style now matches the M3
      Compose theme, so there is no Material 2 → 3 mismatch between what the
      window manager draws before Compose loads and what Compose draws after.
    -->
    <style name="Theme.Sendspin" parent="android:Theme.Material3.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
