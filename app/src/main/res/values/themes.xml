<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pure-black launch theme. The app is OLED-dark end to end, so the window
      starts at #000 (no white flash before Compose draws) and both system bars
      are transparent for the edge-to-edge album wash.

      The parent is the Android framework's Material theme (not Theme.Material3
      from the Material Components library, which is not a dependency). The XML
      theme only governs the window before Compose draws; once Compose loads, the
      M3 MaterialTheme in Theme.kt takes over completely. Upgrading the XML parent
      to Theme.Material3 requires adding com.google.android.material:material,
      which belongs in a later phase alongside the M3 component migration.
    -->
    <style name="Theme.Sendspin" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
