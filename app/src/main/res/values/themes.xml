<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pure-black launch theme. The app is OLED-dark end to end, so the window
      starts at #000 (no white flash before Compose draws) and both system bars
      are transparent for the edge-to-edge album wash.

      Parented on Material 3 to match the Compose layer. This was reverted once,
      to the framework's Material theme, because a CI runner restoring a warm
      Gradle cache from before com.google.android.material was added could not
      resolve it. That dependency has been on master through several green runs
      since, so the reason has expired - and it was always the wrong trade: the
      library was being carried anyway, and the XML theme is what paints the
      window before Compose takes over, so a Material/Material3 mismatch there is
      exactly where a wrong-coloured flash on cold start comes from.
    -->
    <!-- Dark, not DayNight. The app's own theme is a stored preference, not a system
         one - it can be light while the system is dark or the reverse - so a DayNight
         parent would be guessing. windowBackground below is only the value for the
         instant before MainActivity runs: onCreate overwrites it with the page colour
         of the theme actually chosen, read synchronously from the boot mirror. Black
         is the right value to start from because OLED is the default. -->
    <style name="Theme.Sendspin" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>