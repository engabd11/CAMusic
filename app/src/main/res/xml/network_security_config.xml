<?xml version="1.0" encoding="utf-8"?>
<!--
  This app is LAN-first: Music Assistant, Navidrome, and Home Assistant all
  run on the local network and almost never have TLS. Cleartext is permitted
  globally because servers are discovered dynamically via mDNS and their IPs
  are not known in advance — Android's <domain> element does not support
  CIDR ranges, so private IP ranges cannot be enumerated.

  The manifest's usesCleartextTraffic="true" is retained for compatibility
  (Android reads it as a fallback when networkSecurityConfig is present).
  This config is the authoritative source.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- System + user CAs — user CAs are needed for self-signed
                 Navidrome/MA instances that do run TLS on the LAN. -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
